   {"weeks":[1,4],"name":"Base","focus":"Establish surplus, moderate volume","sets":"3 sets","reps":"8-12","rpe":"RPE 7-8"},
   {"weeks":[5,8],"name":"Build","focus":"More volume on key lifts","sets":"4 sets","reps":"6-12","rpe":"RPE 8-9"},
   {"weeks":[9,11],"name":"Push","focus":"Heaviest weights of the block","sets":"4 sets","reps":"5-10","rpe":"RPE 9"},
   {"weeks":[12,12],"name":"Deload","focus":"Recover and reassess body weight","sets":"2 sets","reps":"8-10","rpe":"RPE 6"}],
  "days":[
   {"name":"Upper","exercises":[["barbell-bench-press",4,"6-8"],["barbell-row",4,"6-8"],["seated-dumbbell-shoulder-press",3,"8-10"],["lat-pulldown",3,"10-12"],["ez-bar-curl",3,"10","A"],["skull-crusher",3,"10","A"]]},
