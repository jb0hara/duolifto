   {"name":"Push","exercises":[["incline-barbell-bench-press",4,"8-10"],["machine-chest-press",3,"10-12"],["dumbbell-lateral-raise",4,"12-15","A"],["pec-deck",3,"12-15","A"],["overhead-cable-triceps-extension",3,"12"],["triceps-pushdown-rope",3,"12-15"]]},
   {"name":"Pull","exercises":[["weighted-pull-up",4,"6-8"],["chest-supported-t-bar-row",3,"8-10"],["single-arm-cable-row",3,"10-12"],["reverse-pec-deck",3,"15","A"],["barbell-shrug",3,"12","A"],["incline-dumbbell-curl",3,"10-12"],["hammer-curl",3,"12"]]},
   {"name":"Legs","exercises":[["hack-squat",4,"8-10"],["barbell-hip-thrust",3,"8-10"],["bulgarian-split-squat",3,"10 each"],["leg-extension",3,"15","A"],["seated-leg-curl",3,"15","A"],["seated-calf-raise",3,"15"],["cable-crunch",3,"12-15"]]}]},

 {"id":"cut-8","name":"8-Week Cut","category":"Cutting","weeks":8,"daysPerWeek":4,"level":"All levels",
