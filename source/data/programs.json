   {"name":"Pull","exercises":[["pull-up",4,"6-10"],["barbell-row",3,"8-10"],["seated-cable-row",3,"10-12"],["face-pull",3,"12-15","A"],["incline-dumbbell-curl",3,"10-12","A"],["hammer-curl",3,"10-12"]]},
   {"name":"Legs","exercises":[["back-squat",4,"6-8"],["romanian-deadlift",3,"8-10"],["leg-press",3,"10-12"],["leg-extension",3,"12-15","A"],["seated-leg-curl",3,"12-15","A"],["standing-calf-raise",4,"10-15"],["hanging-leg-raise",3,"10-15"]]}]},

 {"id":"ul-strength-8","name":"8-Week Upper/Lower Strength","category":"Strength","weeks":8,"daysPerWeek":4,"level":"Intermediate",
  "summary":"Four days a week built around the squat, bench, deadlift and overhead press, moving from volume to heavy triples.",
  "nutrition":"Eat at maintenance or slightly above. Strength climbs fastest when you are not in a deficit.",
  "progression":"Percentages are of your current 1 rep max. Add 2.5 kg to main lifts each week you complete every rep.",
