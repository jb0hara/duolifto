   {"weeks":[2,2],"name":"Load","focus":"+1 set on everything","sets":"4 sets","reps":"8-10","rpe":"RPE 8"},
   {"weeks":[3,3],"name":"Overload","focus":"+2 sets, final sets near failure","sets":"5 sets","reps":"6-10","rpe":"RPE 9"}],
  "days":[
