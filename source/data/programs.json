   {"weeks":[7,7],"name":"Overreach","focus":"Last set of each exercise to failure","sets":"4 sets","reps":"6-10","rpe":"RPE 9-10"},
   {"weeks":[8,8],"name":"Deload","focus":"Halve your sets, keep the weights","sets":"2 sets","reps":"8-10","rpe":"RPE 6"}],
