   {"weeks":[3,5],"name":"Strength","focus":"Heavier sets, fewer reps","sets":"4 sets","reps":"4","rpe":"80-85% 1RM"},
   {"weeks":[6,7],"name":"Peak","focus":"Heavy triples and doubles","sets":"3-5 sets","reps":"2-3","rpe":"88-92% 1RM"},
   {"weeks":[8,8],"name":"Test & Deload","focus":"Test a new 1RM early in the week, then rest","sets":"Work to a single","reps":"1","rpe":"RPE 9-10"}],
  "days":[
   {"name":"Upper A (Bench)","exercises":[["barbell-bench-press",5,"5"],["barbell-row",4,"6-8"],["seated-dumbbell-shoulder-press",3,"8-10"],["chin-up",3,"6-10"],["skull-crusher",3,"10-12","A"],["ez-bar-curl",3,"10-12","A"]]},
