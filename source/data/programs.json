   {"name":"Upper B (Press)","exercises":[["overhead-press",5,"5"],["incline-dumbbell-press",3,"8-10"],["weighted-pull-up",4,"5-8"],["chest-supported-dumbbell-row",3,"10"],["face-pull",3,"15","A"],["triceps-pushdown-bar",3,"10-12","A"]]},
